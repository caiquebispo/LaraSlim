################################################################################
# LaraSlim Environment Configuration
################################################################################
# This file contains all environment variables for the LaraSlim application.
# Copy this file to .env and adjust values for your environment.
################################################################################

#-------------------------------------------------------------------------------
# Application Settings
#-------------------------------------------------------------------------------
APP_NAME="LaraSlim"
APP_ENV=local
# Options: local, testing, staging, production
APP_DEBUG=true
APP_URL=http://localhost:8003
APP_TIMEZONE=UTC
APP_LOCALE=en

#-------------------------------------------------------------------------------
# Database Configuration
#-------------------------------------------------------------------------------
DB_CONNECTION=mysql
# Options: mysql, sqlite, pgsql

# MySQL/PostgreSQL settings
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=LaraSlim_db
DB_USERNAME=root
DB_PASSWORD=root

# SQLite settings (if DB_CONNECTION=sqlite)
# DB_DATABASE=../storage/database.sqlite

#-------------------------------------------------------------------------------
# Logging Configuration
#-------------------------------------------------------------------------------
LOG_CHANNEL=file
# Options: file, stderr, null
LOG_LEVEL=debug
# Options: emergency, alert, critical, error, warning, notice, info, debug
LOG_DEPRECATIONS_CHANNEL=null

#-------------------------------------------------------------------------------
# Cache Configuration
#-------------------------------------------------------------------------------
CACHE_DRIVER=file
# Options: file, array

#-------------------------------------------------------------------------------
# CORS Configuration
#-------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
# Use comma-separated values for multiple origins: http://localhost:3000,http://example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

#-------------------------------------------------------------------------------
# Security
#-------------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
# Set to false to disable security headers in development

#-------------------------------------------------------------------------------
# Docker/Container Settings (used by docker-compose)
#-------------------------------------------------------------------------------
# These are typically only used in docker-compose.yml
# MYSQL_ROOT_PASSWORD=${DB_PASSWORD}
# MYSQL_DATABASE=${DB_DATABASE}
